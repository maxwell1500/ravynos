+static void hvf_log_sync(MemoryListener *listener,
+                         MemoryRegionSection *section)
+{
+    /*
+     * Called by memory_region_sync_dirty_bitmap() right before a consumer
+     * snapshots and clears the dirty bitmap -- which is how vga refreshes
+     * the display (memory_region_snapshot_and_clear_dirty() in
+     * vga_draw_graphic()).  Re-protect the range here: every page dirtied
+     * since the last cycle was un-protected by ept_emulation_fault(), and
+     * without this hook those pages never fault again, never set a dirty
+     * bit again, and the display stops updating after each page's first
+     * write.  log_clear() alone is not enough: the vga clear path never
+     * emits it.
+     */
+    if (hvf_dirty_overflow) {
+        hvf_protect_clean_range(section->offset_within_address_space,
+                                int128_get64(section->size));
+    } else {
+        hvf_reprotect_recorded_pages();
+    }
+}
