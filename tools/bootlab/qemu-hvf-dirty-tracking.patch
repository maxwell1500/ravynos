+/*
+ * Pages the EPT fault handler has un-protected since the last dirty-bitmap
+ * sync.  Each of them was write-protected by dirty tracking, faulted once,
+ * and was then made writable again so the guest does not fault on every
+ * store; hvf_log_sync() re-protects exactly these pages when the dirty
+ * bitmap is cleared.  Recording them (instead of re-protecting the whole
+ * region) keeps the idle cost at zero and the busy cost proportional to the
+ * damage: re-protecting a 16 MiB vram region on every 30 ms display tick
+ * cost a full core.
+ */
+#define HVF_DIRTY_MAX 65536
+static struct { hwaddr addr; size_t size; } hvf_dirty_pages[HVF_DIRTY_MAX];
+static unsigned hvf_dirty_count;
+static bool hvf_dirty_overflow;
+/*
+ * Appended by the EPT fault handler on the vcpu thread, drained by
+ * hvf_log_sync() on the main loop thread.  A lost entry means a page that
+ * is left writable forever: it never faults again, never sets a dirty bit
+ * again, and its part of the screen freezes.
+ */
+static QemuMutex hvf_dirty_lock;
+static bool hvf_dirty_lock_init;
+
+static void hvf_dirty_lock_ensure(void)
+{
+    if (!hvf_dirty_lock_init) {
+        qemu_mutex_init(&hvf_dirty_lock);
+        hvf_dirty_lock_init = true;
+    }
+}
+
 void hvf_unprotect_dirty_range(hwaddr addr, size_t size)
 {
     do_hv_vm_protect(addr, size,
                      HV_MEMORY_READ | HV_MEMORY_WRITE | HV_MEMORY_EXEC);
+
+    /* Called from the EPT fault handler (one page) and from log_stop()
+     * (whole region, logging being turned off -- in which case there is no
+     * sync coming and the record is dropped below in hvf_log_stop). */
+    hvf_dirty_lock_ensure();
+    qemu_mutex_lock(&hvf_dirty_lock);
+    if (hvf_dirty_count < HVF_DIRTY_MAX) {
+        hvf_dirty_pages[hvf_dirty_count].addr = addr;
+        hvf_dirty_pages[hvf_dirty_count].size = size;
+        hvf_dirty_count++;
+    } else {
+        hvf_dirty_overflow = true;
+    }
+    qemu_mutex_unlock(&hvf_dirty_lock);
+}
+
+static void hvf_reprotect_recorded_pages(void)
+{
+    hvf_dirty_lock_ensure();
+    qemu_mutex_lock(&hvf_dirty_lock);
+    for (unsigned i = 0; i < hvf_dirty_count; i++) {
+        hvf_protect_clean_range(hvf_dirty_pages[i].addr,
+                                hvf_dirty_pages[i].size);
+    }
+    hvf_dirty_count = 0;
+    hvf_dirty_overflow = false;
+    qemu_mutex_unlock(&hvf_dirty_lock);
 }
 
