# Build output under Libraries/. The real archives (libc++.a, libc++abi.a,
# libunwind.a, libclang_rt.osx.a) live in llvm_target/ and MUST NOT be
# committed: they are build products, ~7 MB, and one of the standing
# commitments is that real binaries never enter the repo or its history.
/llvm_target/

# Per-component build products
/objc4/*.o
/objc4/*.a
/objc4/*.dylib
/objc4/*.tmp
/CrashReporterClient/*.o
/CrashReporterClient/*.a
/CrashReporterClient/*.dylib
/dyld/*.o
/dyld/*.dylib
/dyld3/*.o.tmp
/dyld/*.o.tmp

# Libsystem is built in place, so its archives, dylibs and objects land beside
# their sources. These are build products, not sources to publish.
/Libsystem/*.o
/Libsystem/**/*.o
/Libsystem/*.a
/Libsystem/*.dylib
/Libsystem/**/*.a
/Libsystem/**/*.dylib

# compiler_rt's objects, generated include tree and the libkern symlink.
# Libsystem builds in place, so ${.OBJDIR}/compiler_rt IS this directory;
# /Libsystem/**/*.o above already covered the objects, but the directory and
# the ${RT_INCDIR}/libkern symlink (which points into the machine-local build
# SDK and is therefore broken on any other checkout) were not ignored.
/Libsystem/compiler_rt/

# MIG-generated files emitted by mig from the .def files and regenerated by
# each build; not hand-written source.
/Libsystem/libdispatch/firehose*.c
/Libsystem/libdispatch/firehose*.h
/Libsystem/libdispatch/protocol*.h
/Libsystem/libdispatch/libdispatch_internal_protocol*.c
/Libsystem/liblaunch/helper*.h
/Libsystem/liblaunch/job*.c
/Libsystem/liblaunch/job*.h

# The remaining mig outputs, from the same rule: emitted by the per-component
# Makefiles from the tracked .def files and regenerated by every build.
/Libsystem/liblaunch/launchd_helper*.c
/Libsystem/liblaunch/launchd_helper*.h
/Libsystem/libsystem_asl/asl_ipc*.c
/Libsystem/libsystem_asl/asl_ipc*.h
# Spelled out rather than globbed: notify_ipc_types.h sits beside them and is
# hand-written source, so notify_ipc*.h would hide a real header.
/Libsystem/libsystem_notify/notify_ipc.h
/Libsystem/libsystem_notify/notify_ipcUser.c
/Libsystem/libsystem_notify/notify_ipcServer.c
/Libsystem/libsystem_info/notify_ipc.h
/Libsystem/libsystem_info/notify_ipcUser.c
/Libsystem/libsystem_info/notify_ipcServer.c

# libsystem_c's link lists, produced by xcodescripts/build_linklists.sh. These
# cannot be committed even in principle: each line is an ABSOLUTE path into
# the machine-local build tree ($BUILT_PRODUCTS_DIR/lib*.a), so a committed
# copy would name /Users/max/... on every other checkout.
/Libsystem/libsystem_c/*.linklist
/Libsystem/libsystem_c/*.linklist.libtool
/Libsystem/libsystem_c/interposable.list
/Libsystem/libsystem_c/unexport.list
/Libsystem/libsystem_c/deps.c

# Libraries/Libsystem/Makefile's own generated inputs: the config header
# derived from this host's compiler-rt/dispatch/dyld availability, and the
# linker's recorded-argument scratch files.
/Libsystem/config.*.normal.h
/Libsystem/linker_arguments*.txt
/Libsystem/linker_arguments_changed.c
/Libsystem/linker_arguments_tmp/

# libsystem_kernel's generated trees. internal_hdr/ and mig_hdr/ are built
# from xnu's own mach/*.defs; obj/ and sys/ are the generated syscall stubs and
# their objects. All four are product directories named as ${.OBJDIR} in that
# component's Makefile.
/Libsystem/libsystem_kernel/internal_hdr/
/Libsystem/libsystem_kernel/mig_hdr/
/Libsystem/libsystem_kernel/obj/
/Libsystem/libsystem_kernel/sys/

# Headers staged into a component's object directory by its `prep` step, copied
# verbatim out of Default.xctoolchain/include and libsystem_blocks. They are
# copies of files that are themselves tracked elsewhere, and libmacho's and
# libdispatch's own Makefiles recreate them on every build.
/Libsystem/libmacho/mach-o/
/Libsystem/libmacho/stuff/
/Libsystem/libdispatch/BlocksRuntime/

# dyld's static archives and the chroot_util test driver. chroot_util is
# linked three ways (.debug/.full variants are ld flags baked into the name),
# so they cannot be covered by an extension rule.
/dyld/**/*.a
/dyld/chroot_util/chroot_util
/dyld/chroot_util/chroot_util.*
/dyld/chroot_util/.depend
/dyld/dyld/*.gz.gz
