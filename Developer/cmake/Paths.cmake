# ravynOS Paths settings for CMake builds
if(NOT DEFINED ROOT_SOURCE_DIR)
    get_filename_component(ROOT_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
endif()
if(NOT DEFINED ROOT_BINARY_DIR)
    if(DEFINED ENV{RAVYN_BUILD_DIR})
        set(ROOT_BINARY_DIR "$ENV{RAVYN_BUILD_DIR}")
    else()
        set(ROOT_BINARY_DIR "/Users/max/Projects/build")
    endif()
endif()
if(NOT DEFINED RAVYN_SDKROOT)
    set(RAVYN_SDKROOT "${ROOT_SOURCE_DIR}/Developer/ravynOS.sdk")
endif()
if(NOT DEFINED SYSROOT_DIR)
    set(SYSROOT_DIR "${RAVYN_SDKROOT}")
endif()
