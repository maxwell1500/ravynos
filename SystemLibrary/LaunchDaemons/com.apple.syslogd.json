{
  "HopefullyExitsLast": true,
  "EnvironmentVariables": {
    "ASL_DISABLE": "1"
  },
  "POSIXSpawnType": "Adaptive",
  "MachServices": {
    "com.apple.system.logger": {
      "ResetAtClose": true
    }
  },
  "EnableTransactions": true,
  "ProgramArguments": [
    "/usr/sbin/syslogd"
  ],
  "OnDemand": false,
  "KeepAlive": true,
  "RunAtLoad": true,
  "Label": "com.apple.syslogd"
}
